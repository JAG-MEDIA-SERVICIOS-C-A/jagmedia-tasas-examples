{
  "info": {
    "name": "JAG-Media · API de Tasas",
    "description": "Colección pública — tasas de cambio venezolanas. Auth: X-API-Key (obtener en jagmedia.com.ve/cuenta.php).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "base_url", "value": "https://api.jagmedia.com.ve"},
               {"key": "api_key", "value": "jmg_tu_api_key"}],
  "item": [
    {"name": "Estado de fuentes (sin auth)",
     "request": {"method": "GET", "header": [],
       "url": {"raw": "{{base_url}}/v1/estado",
         "host": ["{{base_url}}"], "path": ["v1","estado"]}}},
    {"name": "Tasas consolidadas",
     "request": {"method": "GET",
       "header": [{"key": "X-API-Key", "value": "{{api_key}}"}],
       "url": {"raw": "{{base_url}}/v1/tasas",
         "host": ["{{base_url}}"], "path": ["v1","tasas"]}}},
    {"name": "Convertir USD→VES",
     "request": {"method": "GET",
       "header": [{"key": "X-API-Key", "value": "{{api_key}}"}],
       "url": {"raw": "{{base_url}}/v1/convertir?monto=10&moneda=USD&destino=VES",
         "host": ["{{base_url}}"], "path": ["v1","convertir"],
         "query": [{"key":"monto","value":"10"},{"key":"moneda","value":"USD"},{"key":"destino","value":"VES"}]}}},
    {"name": "Spread BCV vs mercado",
     "request": {"method": "GET",
       "header": [{"key": "X-API-Key", "value": "{{api_key}}"}],
       "url": {"raw": "{{base_url}}/v1/spread",
         "host": ["{{base_url}}"], "path": ["v1","spread"]}}},
    {"name": "Histórico USD (Starter+)",
     "request": {"method": "GET",
       "header": [{"key": "X-API-Key", "value": "{{api_key}}"}],
       "url": {"raw": "{{base_url}}/v1/historico/USD",
         "host": ["{{base_url}}"], "path": ["v1","historico","USD"]}}},
    {"name": "Bancos",
     "request": {"method": "GET",
       "header": [{"key": "X-API-Key", "value": "{{api_key}}"}],
       "url": {"raw": "{{base_url}}/bancos",
         "host": ["{{base_url}}"], "path": ["bancos"]}}},
    {"name": "Login → JWT",
     "request": {"method": "POST",
       "header": [{"key": "Content-Type", "value": "application/json"}],
       "body": {"mode": "raw",
         "raw": "{\"email\": \"tu@email.com\", \"password\": \"tu_password\"}"},
       "url": {"raw": "{{base_url}}/auth/token",
         "host": ["{{base_url}}"], "path": ["auth","token"]}}}
  ]
}
